@page
@model tanningTribe.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Your Cart";
}

<h1 class="h3 mb-4">Your Cart</h1>

@if (Model.Items.Count == 0)
{
    <div class="bg-white rounded-4 p-5 text-center">
        <p class="lead mb-3">Your cart is empty.</p>
        <a asp-page="/Shop/Index" class="btn btn-brand">Start Shopping</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="bg-white rounded-4 p-3">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th colspan="2">Product</th>
                            <th>Price</th>
                            <th style="width: 140px">Qty</th>
                            <th class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="width: 80px"><img src="@item.ImageUrl" alt="@item.Name" class="rounded" width="64" height="64" /></td>
                                <td>@item.Name</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>
                                    <form method="post" asp-page-handler="Update" asp-route-productId="@item.ProductId" class="d-flex gap-1">
                                        <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Update</button>
                                    </form>
                                </td>
                                <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Remove" asp-route-productId="@item.ProductId">
                                        <button type="submit" class="btn btn-link text-danger btn-sm">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-white rounded-4 p-4">
                <h2 class="h5">Order Summary</h2>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span>Subtotal</span>
                    <span class="fw-semibold">@Model.Total.ToString("C")</span>
                </div>
                <p class="text-muted small mt-2">Payment details are sent by WhatsApp once your order is approved.</p>
                <a asp-page="/Checkout/Index" class="btn btn-brand w-100 btn-lg mt-2">Checkout</a>
                <a asp-page="/Shop/Index" class="btn btn-link w-100 mt-1">Continue shopping</a>
            </div>
        </div>
    </div>
}
