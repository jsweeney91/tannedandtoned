@model Product

<div class="card product-card h-100">
    <a class="card-img-wrap" asp-page="/Shop/Details" asp-route-slug="@Model.Slug">
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" loading="lazy" />
        <span class="badge category-badge">@Model.Category</span>
    </a>
    <div class="card-body d-flex flex-column">
        <h3 class="h6 card-title mb-2">
            <a class="text-decoration-none" asp-page="/Shop/Details" asp-route-slug="@Model.Slug">@Model.Name</a>
        </h3>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="price">@Model.Price.ToString("C")</span>
            <form method="post" asp-page="/Cart/Index" asp-page-handler="Add" asp-route-productId="@Model.Id">
                <button type="submit" class="btn btn-brand btn-sm">Add to bag</button>
            </form>
        </div>
    </div>
</div>
