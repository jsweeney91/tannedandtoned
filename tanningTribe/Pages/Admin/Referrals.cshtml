@page
@model tanningTribe.Pages.Admin.ReferralsModel
@{
    ViewData["Title"] = "Referral Codes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Referral Codes</h1>
    <span class="text-muted small">@Model.Codes.Count codes &middot; @Model.TotalUses total uses &middot; @Model.ActiveReferrers referrers with at least one use</span>
</div>

<div class="bg-white rounded-4 p-3">
    <table class="table align-middle mb-0">
        <thead>
            <tr><th>Code</th><th>Owner</th><th>From order</th><th>Discount</th><th>Uses</th><th>Created</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Codes)
            {
                <tr>
                    <td><code class="fs-6">@r.Code</code></td>
                    <td>@r.OwnerEmail</td>
                    <td><a asp-page="/Admin/Orders/Details" asp-route-id="@r.OwnerOrderId">@(r.OwnerOrder?.OrderNumber ?? $"#{r.OwnerOrderId}")</a></td>
                    <td>@r.DiscountPercent%</td>
                    <td class="fw-semibold">@r.TimesUsed</td>
                    <td>@r.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td>
                        @if (r.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id">
                            <button type="submit" class="btn btn-outline-gold btn-sm">@(r.IsActive ? "Disable" : "Enable")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Codes.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No referral codes have been generated yet.</td></tr>
            }
        </tbody>
    </table>
</div>
