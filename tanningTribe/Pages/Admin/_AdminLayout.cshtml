@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="row g-4">
    <aside class="col-lg-2">
        <nav class="admin-nav list-group">
            <a asp-page="/Admin/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Index" ? "active" : "")">Dashboard</a>
            <a asp-page="/Admin/Orders/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Orders") == true ? "active" : "")">Orders</a>
            <a asp-page="/Admin/Products/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Products") == true ? "active" : "")">Products</a>
            <a asp-page="/Admin/Referrals" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Referrals" ? "active" : "")">Referral Codes</a>
            <a asp-page="/Admin/Reviews" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Reviews" ? "active" : "")">Reviews</a>
            <a asp-page="/Admin/Messages/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Messages") == true ? "active" : "")">Messages</a>
            <form method="post" asp-page="/Admin/Logout" class="mt-3">
                <button type="submit" class="btn btn-outline-gold btn-sm w-100">Sign out</button>
            </form>
        </nav>
    </aside>
    <div class="col-lg-10">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
