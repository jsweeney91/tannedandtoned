@page
@model tanningTribe.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Owner Login";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="mx-auto" style="max-width: 420px">
    <div class="bg-white rounded-4 p-4 mt-5">
        <p class="brand-tagline mb-1">Tanned &amp; Toned</p>
        <h1 class="h3 mb-4">Owner Login</h1>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Username</label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-brand w-100">Sign in</button>
        </form>
    </div>
</div>
